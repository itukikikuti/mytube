# エンコード用ワーカーのイメージ (ffmpeg + SVT-AV1 + libvmaf + Av1an + VapourSynth/BestSource)
# Arch Linux の公式パッケージで新しい Av1an / SVT-AV1 をそろえる。Node は Web と同じ版を node:22 から持ってくる

# ---- build stage ----
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

# ---- SVT-AV1 (release) stage ----
# Arch の svt-av1 パッケージはデバッグ版 (メモリの追跡・assert が有効) で約1割遅いので、
# 同じ版をリリース設定でビルドし直して置き換える (出力は同じ)
FROM archlinux:latest AS svt
RUN pacman -Syu --noconfirm --needed base-devel cmake nasm git ninja svt-av1 \
    && version=$(pacman -Q svt-av1 | awk "{print \$2}" | cut -d- -f1) \
    && git clone --depth 1 --branch "v${version}" https://gitlab.com/AOMediaCodec/SVT-AV1.git /svt \
    && cmake -S /svt -B /svt/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
      -DBUILD_APPS=OFF -DBUILD_TESTING=OFF -DBUILD_SHARED_LIBS=ON \
    && cmake --build /svt/build && DESTDIR=/out cmake --install /svt/build

# ---- runtime stage ----
FROM archlinux:latest AS runtime
RUN pacman -Syu --noconfirm --needed \
      av1an svt-av1 ffmpeg vmaf vapoursynth vapoursynth-plugin-bestsource mkvtoolnix-cli util-linux \
    && pacman -Scc --noconfirm \
    && rm -rf /var/cache/pacman/pkg/*
COPY --from=svt /out/usr/lib/ /usr/lib/
COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY docker/ffmpeg-av1an-wrapper.sh /usr/local/bin/ffmpeg
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
# Web コンテナと同じく root で動かす (data/encode.sqlite を両方から書くため)
# 低優先度 (nice 19 / I/O は idle) で動かし、Web や他のサービスの邪魔をしない
CMD ["ionice", "-c", "3", "nice", "-n", "19", "node", "dist/encode/worker.js"]
